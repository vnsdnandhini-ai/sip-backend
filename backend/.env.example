# Database Configuration (Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Storage & Client Configuration
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: Google Gemini API Key for image/spectral intelligence
GEMINI_API_KEY=your_gemini_api_key

# Server Port (automatically assigned on Render, defaults to 3000 locally)
PORT=3000

# ========================================
# REAL OTP CONFIGURATION (SMS & EMAIL)
# ========================================

# TWILIO CONFIG (For Real SMS OTP)
# Get these by creating a free account at twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# GMAIL CONFIG (For Real Email OTP)
# Use your gmail address and generate an "App Password" from Google Account settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password_here
